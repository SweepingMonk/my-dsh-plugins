{
  "name": "@local/markdown-mermaid",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Enhance the built-in Markdown preview by drawing its Mermaid code blocks as diagrams",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/enhancer.test.mjs && node test/zoom-contract.test.mjs"
  },
  "dependencies": {
    "mermaid": "11.12.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
